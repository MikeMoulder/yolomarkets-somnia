# ---------------------------------------------------------------------------
# YOLO Markets - Somnia Shannon testnet / DreamDEX Event Contracts
#
# Copy to `.env` at the repo root. Both the web app and the Python agent read
# this file (scripts/load-env.ts loads it before anything imports lib/db).
# ---------------------------------------------------------------------------

# ── Network ────────────────────────────────────────────────────────────────
# Baked-in defaults match these, so you only need to set them to override.
SOMNIA_CHAIN_ID=50312
SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SOMNIA_EXPLORER_URL=https://shannon-explorer.somnia.network

# How long the SDK's market map stays fresh, in ms. Contracts roll on a
# ~60s cadence and this map is what turns a marketId into a tradable symbol,
# so keep it well under the shortest series interval.
SOMNIA_MARKETS_TTL_MS=20000

# ── The desk's wallet ──────────────────────────────────────────────────────
# Needs BOTH tokens, and they are unrelated:
#   STT   = gas   -> Somnia testnet faucet / SomniaHacks Telegram
#   tUSDC = collateral -> self-serve, `npm run somnia:smoke -- --fund`
# A wallet full of tUSDC still cannot place an order.
SOMNIA_ADDRESS=0x0000000000000000000000000000000000000000
SOMNIA_PRIVATE_KEY=

# ── Execution bridge ───────────────────────────────────────────────────────
# TypeScript owns the wallet; Python reaches it over localhost only.
BRIDGE_PORT=8091
# 1 = every write is a no-op that still returns the shape of a real fill.
# Set to 0 to actually sign.
BRIDGE_DRY_RUN=1
AGENT_BRIDGE_SECRET=change-me
AGENT_BRIDGE_URL=http://127.0.0.1:8091
AGENT_BRIDGE_TIMEOUT_S=30

# ── Strategy ───────────────────────────────────────────────────────────────
AGENT_EDGE_THRESHOLD=0.04        # min edge in probability (0-1) before acting
AGENT_KELLY_FRACTION=0.25        # quarter-Kelly
AGENT_MAX_POSITION_FRACTION=0.10 # hard cap per contract, share of bankroll
AGENT_MIN_TTE_SECONDS=45         # refuse to open closer than this to expiry
AGENT_MIN_ANNUAL_VOL=0.20        # vol clamps: a flat feed must not read as
AGENT_MAX_ANNUAL_VOL=3.00        # certainty, one bad tick must not blow up
AGENT_MAX_ORDERS_PER_PASS=3
AGENT_MAX_MARKETS=40
AGENT_BOOK_DEPTH=5
AGENT_VOL_CANDLES=60             # 1m candles used for realized volatility
AGENT_POLL_SECONDS=30

# ── Web app ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_ADDRESS=
# Optional; injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Persistence (optional) ─────────────────────────────────────────────────
# Postgres backs the decision feed and the agent's journal. Everything runs
# without it - the journal is decoration, never load-bearing.
DATABASE_URL=

# ── LLM (optional) ─────────────────────────────────────────────────────────
# Only the chat copilot and narrative-tier markets need this. The analytic
# pricing path makes no LLM calls at all.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3-flash-preview
AGENT_CHAT_SHARED_SECRET=
AGENT_SERVICE_URL=http://127.0.0.1:8081
